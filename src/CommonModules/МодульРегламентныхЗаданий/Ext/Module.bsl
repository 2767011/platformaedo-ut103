////////////////////////////////////////////////////////////////////////////////
// Носитель расписания регламентов ЭДО для КАТАП (КА торговли алкоголем 1.1).
//
// Ядро вешает регламенты на типовое задание ЗаданиеОбменЭлектроннымиДокументами, которого
// в КА 1.1 нет вовсе - ни задания, ни метода. Поэтому носитель здесь, в профиле: перехвачен
// метод задания ЗаданиеАвтономноеРешение - оно непредопределённое, экземпляра в базе не имеет
// (проверено 14.09.2026: платформа его не запускает, типовая логика им не пользуется),
// метод принимает один параметр - ровно та же схема, что у носителя ядра.
//
// Экземпляры регламентов ЭДО заводятся на ЭТОМ задании, параметр - ключ регламента из
// ЭДО_Регламенты.КлючиРегламентов(), наименование начинается с "ЭДО: ".
////////////////////////////////////////////////////////////////////////////////

&Вместо("ВыполнитьОбменДаннымиДляНастройкиОбмена")
Процедура ЭДО_ВыполнитьОбменДаннымиДляНастройкиОбмена(КодНастройки)

	// Ядро - другое расширение: прямое обращение к его модулю компилятор профиля не
	// разрешает, поэтому через Выполнить. Разводка «ключ -> регламент» вся в ядре
	// (ЭДО_Регламенты.ВыполнитьРегламентПоКлючу): новый регламент ядра подхватится без правки здесь.
	Выполнено = Ложь;
	Если Метаданные.ОбщиеМодули.Найти("ЭДО_Регламенты") <> Неопределено Тогда
		Выполнить("Выполнено = ЭДО_Регламенты.ВыполнитьРегламентПоКлючу(КодНастройки)");
	КонецЕсли;

	// чужой ключ или ядро не установлено - типовое поведение нетронуто
	Если НЕ Выполнено Тогда
		ПродолжитьВызов(КодНастройки);
	КонецЕсли;

КонецПроцедуры
