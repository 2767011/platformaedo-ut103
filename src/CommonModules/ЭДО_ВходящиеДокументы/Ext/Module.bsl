////////////////////////////////////////////////////////////////////////////////
// Входящие электронные документы: разбор XML титула продавца в структуру, не зависящую
// от конфигурации. Документ базы по этой структуре создает профиль базы (точка
// ПриСозданииДокументаПоВходящему), разбор о базе ничего не знает и проверяется на файлах.
//
// Поддержан УПД/СЧФ/ДОП по приказу ФНС (ON_NSCHFDOPPR) версий 5.01 и 5.03: имена узлов и
// атрибутов, которые в версиях различаются, читаются из обоих вариантов.
////////////////////////////////////////////////////////////////////////////////

#Область РазборУПД

// Разобрать XML титула продавца УПД (ON_NSCHFDOPPR).
// Данные - ДвоичныеДанные файла (кодировку берет из объявления XML) или Строка с текстом XML.
// Возврат: Структура, см. НовыйРазборУПД. Ошибки разбора, при которых документ еще можно
// показать (не сошлась сумма, нет обязательного поля), - в Предупреждения; файл, который
// не является УПД, - исключение.
Функция РазобратьУПД(Знач Данные) Экспорт

	// Документ DOM держим в переменной: без ссылки на него элементы становятся недействительными.
	ДокументDOM = ДокументXML(Данные);
	Корень = ДокументDOM.ЭлементДокумента;
	Если Корень.ИмяЭлемента <> "Файл" Тогда
		ВызватьИсключение "Это не файл документа ФНС: корневой элемент «" + Корень.ИмяЭлемента + "»";
	КонецЕсли;

	Разбор = НовыйРазборУПД();
	Разбор.ИдФайла = Атрибут(Корень, "ИдФайл");
	ЧастиИд = СтрРазделить(Разбор.ИдФайла, "_");
	Если ЧастиИд.Количество() >= 2 Тогда
		Разбор.Формат = ВРег(ЧастиИд[0] + "_" + ЧастиИд[1]);
	КонецЕсли;
	Разбор.ВерсияФормата = Атрибут(Корень, "ВерсФорм");
	Разбор.Программа = Атрибут(Корень, "ВерсПрог");

	Документ = Дочерний(Корень, "Документ");
	Если Документ = Неопределено Тогда
		ВызватьИсключение "В файле нет узла «Документ»";
	КонецЕсли;
	Разбор.Функция = Атрибут(Документ, "Функция");

	СвСчФакт = Дочерний(Документ, "СвСчФакт");
	Если СвСчФакт = Неопределено Тогда
		ВызватьИсключение "В файле нет узла «СвСчФакт»: это не титул продавца УПД";
	КонецЕсли;
	// 5.03: НомерДок/ДатаДок; 5.01: НомерСчФ/ДатаСчФ.
	Разбор.Номер = ПервыйНепустой(Атрибут(СвСчФакт, "НомерДок"), Атрибут(СвСчФакт, "НомерСчФ"));
	Разбор.Дата = ДатаИзСтроки(ПервыйНепустой(Атрибут(СвСчФакт, "ДатаДок"), Атрибут(СвСчФакт, "ДатаСчФ")));
	Разбор.Валюта = ПервыйНепустой(Атрибут(Дочерний(СвСчФакт, "ДенИзм"), "КодОКВ"), Атрибут(СвСчФакт, "КодОКВ"));

	// 5.03: ИспрДок; 5.01: ИспрСчФ.
	Испр = Дочерний(СвСчФакт, "ИспрДок");
	Если Испр = Неопределено Тогда
		Испр = Дочерний(СвСчФакт, "ИспрСчФ");
	КонецЕсли;
	Если Испр <> Неопределено Тогда
		Разбор.НомерИсправления = ПервыйНепустой(Атрибут(Испр, "НомИспр"), Атрибут(Испр, "НомИспрСчФ"));
		Разбор.ДатаИсправления = ДатаИзСтроки(ПервыйНепустой(Атрибут(Испр, "ДатаИспр"), Атрибут(Испр, "ДатаИспрСчФ")));
	КонецЕсли;

	Разбор.Продавец = Участник(Дочерний(СвСчФакт, "СвПрод"));
	Разбор.Покупатель = Участник(Дочерний(СвСчФакт, "СвПокуп"));
	Разбор.Грузополучатель = Участник(Дочерний(СвСчФакт, "ГрузПолуч"));
	ГрузОт = Дочерний(СвСчФакт, "ГрузОт");
	Если ГрузОт <> Неопределено Тогда
		Если Дочерний(ГрузОт, "ОнЖе") <> Неопределено Тогда
			Разбор.ГрузоотправительОнЖе = Истина;
		Иначе
			Разбор.Грузоотправитель = Участник(Дочерний(ГрузОт, "ГрузОтпр"));
		КонецЕсли;
	КонецЕсли;

	// 5.03: ДокПодтвОтгрНом (Рекв*); 5.01: ДокПодтвОтгр (НаимДокОтгр/НомДокОтгр/ДатаДокОтгр).
	Для Каждого Узел Из Дочерние(СвСчФакт, "ДокПодтвОтгрНом") Цикл
		Разбор.ДокументыОтгрузки.Добавить(РеквизитыДокумента(Узел));
	КонецЦикла;
	Для Каждого Узел Из Дочерние(СвСчФакт, "ДокПодтвОтгр") Цикл
		Разбор.ДокументыОтгрузки.Добавить(Новый Структура("Наименование, Номер, Дата",
			Атрибут(Узел, "НаимДокОтгр"), Атрибут(Узел, "НомДокОтгр"), ДатаИзСтроки(Атрибут(Узел, "ДатаДокОтгр"))));
	КонецЦикла;
	ПрочитатьИнфПоля(Дочерний(СвСчФакт, "ИнфПолФХЖ1"), Разбор.ИнфПоля);

	ПрочитатьСведенияОПередаче(Документ, Разбор);

	Таблица = Дочерний(Документ, "ТаблСчФакт");
	Если Таблица = Неопределено Тогда
		Разбор.Предупреждения.Добавить("В документе нет таблицы товаров (ТаблСчФакт)");
		Возврат Разбор;
	КонецЕсли;
	Для Каждого СведТов Из Дочерние(Таблица, "СведТов") Цикл
		Разбор.Строки.Добавить(СтрокаТовара(СведТов, Разбор.Предупреждения));
	КонецЦикла;

	Всего = Дочерний(Таблица, "ВсегоОпл");
	Если Всего <> Неопределено Тогда
		Разбор.СуммаБезНДС = ЧислоИзСтроки(Атрибут(Всего, "СтТовБезНДСВсего"));
		Разбор.СуммаСНДС = ЧислоИзСтроки(Атрибут(Всего, "СтТовУчНалВсего"));
		Разбор.СуммаНДС = СуммаНалога(Дочерний(Всего, "СумНалВсего"));
	КонецЕсли;
	ПроверитьИтоги(Разбор);

	Возврат Разбор;

КонецФункции

// Пустая структура разбора. Строки - Массив структур, см. НоваяСтрокаТовара.
Функция НовыйРазборУПД() Экспорт

	Разбор = Новый Структура;
	Разбор.Вставить("Формат", "");              // ON_NSCHFDOPPR
	Разбор.Вставить("ВерсияФормата", "");       // 5.03
	Разбор.Вставить("Программа", "");           // ВерсПрог отправителя
	Разбор.Вставить("ИдФайла", "");
	Разбор.Вставить("Функция", "");             // СЧФ, СЧФДОП, ДОП
	Разбор.Вставить("Номер", "");
	Разбор.Вставить("Дата", '00010101');
	Разбор.Вставить("НомерИсправления", "");
	Разбор.Вставить("ДатаИсправления", '00010101');
	Разбор.Вставить("Валюта", "");              // код ОКВ, 643 - рубль
	Разбор.Вставить("Продавец", Неопределено);   // см. Участник
	Разбор.Вставить("Покупатель", Неопределено);
	Разбор.Вставить("Грузоотправитель", Неопределено);
	Разбор.Вставить("ГрузоотправительОнЖе", Ложь);
	Разбор.Вставить("Грузополучатель", Неопределено);
	Разбор.Вставить("ДокументыОтгрузки", Новый Массив);   // Структура (Наименование, Номер, Дата)
	Разбор.Вставить("Основания", Новый Массив);           // Структура (Наименование, Номер, Дата)
	Разбор.Вставить("ДатаОтгрузки", '00010101');
	Разбор.Вставить("СодержаниеОперации", "");
	Разбор.Вставить("ИнфПоля", Новый Соответствие);       // ИнфПолФХЖ1: Идентиф -> Значен
	Разбор.Вставить("СуммаБезНДС", 0);
	Разбор.Вставить("СуммаНДС", 0);
	Разбор.Вставить("СуммаСНДС", 0);
	Разбор.Вставить("Строки", Новый Массив);
	Разбор.Вставить("Предупреждения", Новый Массив);
	Возврат Разбор;

КонецФункции

// Пустая строка товара. Коды маркировки лежат и как в файле - группами НомСредИдентТов
// (у группы бывает транспортная упаковка и количество), и плоскими списками по видам:
// КИЗ - коды единиц, Упаковки - групповые упаковки (НомУпак), ТранспортныеУпаковки -
// ИдентТрансУпак. Раскрыть упаковку до единиц может только получатель (через Честный знак).
Функция НоваяСтрокаТовара() Экспорт

	Строка = Новый Структура;
	Строка.Вставить("НомерСтроки", 0);
	Строка.Вставить("Наименование", "");
	Строка.Вставить("КраткоеНаименование", "");
	Строка.Вставить("КодОКЕИ", "");
	Строка.Вставить("ЕдиницаИзмерения", "");
	Строка.Вставить("Количество", 0);
	Строка.Вставить("Цена", 0);
	Строка.Вставить("СуммаБезНДС", 0);
	Строка.Вставить("СтавкаНДС", "");           // как в файле: 22%, 10%, 0%, без НДС, 22/122 ...
	Строка.Вставить("СуммаНДС", 0);
	Строка.Вставить("СуммаСНДС", 0);
	Строка.Вставить("СуммаАкциза", 0);
	Строка.Вставить("КодТовара", "");           // КодТов: код номенклатуры продавца
	Строка.Вставить("Артикул", "");
	Строка.Вставить("GTIN", "");
	Строка.Вставить("КодВидаТовара", "");       // КодВидТов: ТН ВЭД
	Строка.Вставить("ПризнакТовара", "");       // ПрТовРаб: 1 товар, 2 работа, 3 услуга ...
	Строка.Вставить("СтранаПроисхождения", "");
	Строка.Вставить("НомерДТ", "");
	Строка.Вставить("ИнфПоля", Новый Соответствие);   // ИнфПолФХЖ2: Идентиф -> Значен
	Строка.Вставить("ГруппыМаркировки", Новый Массив); // Структура (ТранспортнаяУпаковка, Количество, КИЗ, Упаковки)
	Строка.Вставить("КИЗ", Новый Массив);
	Строка.Вставить("Упаковки", Новый Массив);
	Строка.Вставить("ТранспортныеУпаковки", Новый Массив);
	Возврат Строка;

КонецФункции

Функция СтрокаТовара(Знач СведТов, Предупреждения)

	Строка = НоваяСтрокаТовара();
	Строка.НомерСтроки = ЧислоИзСтроки(Атрибут(СведТов, "НомСтр"));
	Строка.Наименование = Атрибут(СведТов, "НаимТов");
	Строка.КодОКЕИ = Атрибут(СведТов, "ОКЕИ_Тов");
	Строка.ЕдиницаИзмерения = Атрибут(СведТов, "НаимЕдИзм");
	Строка.Количество = ЧислоИзСтроки(Атрибут(СведТов, "КолТов"));
	Строка.Цена = ЧислоИзСтроки(Атрибут(СведТов, "ЦенаТов"));
	Строка.СуммаБезНДС = ЧислоИзСтроки(Атрибут(СведТов, "СтТовБезНДС"));
	Строка.СтавкаНДС = Атрибут(СведТов, "НалСт");
	Строка.СуммаСНДС = ЧислоИзСтроки(Атрибут(СведТов, "СтТовУчНал"));
	Строка.СуммаНДС = СуммаНалога(Дочерний(СведТов, "СумНал"));
	Строка.СуммаАкциза = ЧислоИзСтроки(ТекстЭлемента(Дочерний(Дочерний(СведТов, "Акциз"), "СумАкциз")));

	Доп = Дочерний(СведТов, "ДопСведТов");
	Если Доп <> Неопределено Тогда
		Строка.КодТовара = Атрибут(Доп, "КодТов");
		Строка.Артикул = Атрибут(Доп, "АртикулТов");
		Строка.GTIN = Атрибут(Доп, "ГТИН");
		Строка.КодВидаТовара = Атрибут(Доп, "КодВидТов");
		Строка.ПризнакТовара = Атрибут(Доп, "ПрТовРаб");
		Строка.КраткоеНаименование = ТекстЭлемента(Дочерний(Доп, "КрНаимСтрПр"));
		Если НЕ ЗначениеЗаполнено(Строка.ЕдиницаИзмерения) Тогда
			Строка.ЕдиницаИзмерения = Атрибут(Доп, "НаимЕдИзм");   // 5.01
		КонецЕсли;
		Для Каждого Группа Из Дочерние(Доп, "НомСредИдентТов") Цикл
			ДобавитьГруппуМаркировки(Строка, Группа);
		КонецЦикла;
	КонецЕсли;

	// 5.03: СвДТ (НомерДТ); 5.01: СвТД (НомерТД).
	Для Каждого ИмяУзла Из СтрРазделить("СвДТ,СвТД", ",") Цикл
		Для Каждого Узел Из Дочерние(СведТов, ИмяУзла) Цикл
			Строка.СтранаПроисхождения = ПервыйНепустой(Строка.СтранаПроисхождения, Атрибут(Узел, "КодПроисх"));
			Строка.НомерДТ = ПервыйНепустой(Строка.НомерДТ, Атрибут(Узел, "НомерДТ"), Атрибут(Узел, "НомерТД"));
		КонецЦикла;
	КонецЦикла;

	Для Каждого Узел Из Дочерние(СведТов, "ИнфПолФХЖ2") Цикл
		ДобавитьИнфПоле(Строка.ИнфПоля, Узел);
	КонецЦикла;

	Возврат Строка;

КонецФункции

Процедура ДобавитьГруппуМаркировки(Строка, Знач Узел)

	Группа = Новый Структура("ТранспортнаяУпаковка, Количество, КИЗ, Упаковки",
		Атрибут(Узел, "ИдентТрансУпак"), ЧислоИзСтроки(Атрибут(Узел, "КолВедМарк")), Новый Массив, Новый Массив);
	Для Каждого Код Из Дочерние(Узел, "КИЗ") Цикл
		Группа.КИЗ.Добавить(ТекстЭлемента(Код));
		Строка.КИЗ.Добавить(ТекстЭлемента(Код));
	КонецЦикла;
	Для Каждого Код Из Дочерние(Узел, "НомУпак") Цикл
		Группа.Упаковки.Добавить(ТекстЭлемента(Код));
		Строка.Упаковки.Добавить(ТекстЭлемента(Код));
	КонецЦикла;
	Если ЗначениеЗаполнено(Группа.ТранспортнаяУпаковка) Тогда
		Строка.ТранспортныеУпаковки.Добавить(Группа.ТранспортнаяУпаковка);
	КонецЕсли;
	Строка.ГруппыМаркировки.Добавить(Группа);

КонецПроцедуры

Процедура ПрочитатьСведенияОПередаче(Знач Документ, Разбор)

	СвПер = Дочерний(Дочерний(Документ, "СвПродПер"), "СвПер");
	Если СвПер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Разбор.ДатаОтгрузки = ДатаИзСтроки(Атрибут(СвПер, "ДатаПер"));
	Разбор.СодержаниеОперации = Атрибут(СвПер, "СодОпер");
	Для Каждого Осн Из Дочерние(СвПер, "ОснПер") Цикл
		Если Осн.ЕстьАтрибут("РеквНаимДок") Тогда
			Разбор.Основания.Добавить(РеквизитыДокумента(Осн));                    // 5.03
		Иначе
			Разбор.Основания.Добавить(Новый Структура("Наименование, Номер, Дата",     // 5.01
				Атрибут(Осн, "НаимОсн"), Атрибут(Осн, "НомОсн"), ДатаИзСтроки(Атрибут(Осн, "ДатаОсн"))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИтоги(Разбор)

	СуммаСтрок = 0;
	Для Каждого Строка Из Разбор.Строки Цикл
		СуммаСтрок = СуммаСтрок + Строка.СуммаСНДС;
	КонецЦикла;
	Если Разбор.СуммаСНДС <> 0 И СуммаСтрок <> Разбор.СуммаСНДС Тогда
		Разбор.Предупреждения.Добавить("Сумма строк (" + Формат(СуммаСтрок, "ЧДЦ=2; ЧГ=0")
			+ ") не равна итогу документа (" + Формат(Разбор.СуммаСНДС, "ЧДЦ=2; ЧГ=0") + ")");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Разбор.Номер) Тогда
		Разбор.Предупреждения.Добавить("В документе нет номера");
	КонецЕсли;
	Если Разбор.Продавец = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Разбор.Продавец.ИНН) Тогда
		Разбор.Предупреждения.Добавить("Не указан ИНН продавца");
	КонецЕсли;

КонецПроцедуры

// Участник (продавец, покупатель, грузоотправитель, грузополучатель): узел с ИдСв внутри.
// Возврат: Структура (ИНН, КПП, Наименование, ЭтоИП, Иностранный) или Неопределено.
Функция Участник(Знач Узел)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("ИНН, КПП, Наименование, ЭтоИП, Иностранный", "", "", "", Ложь, Ложь);
	ИдСв = Дочерний(Узел, "ИдСв");
	Если ИдСв = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЮЛ = Дочерний(ИдСв, "СвЮЛУч");
	ИП = Дочерний(ИдСв, "СвИП");
	Ин = Дочерний(ИдСв, "СвИнНеУч");
	Если ЮЛ <> Неопределено Тогда
		Результат.ИНН = Атрибут(ЮЛ, "ИННЮЛ");
		Результат.КПП = Атрибут(ЮЛ, "КПП");
		Результат.Наименование = Атрибут(ЮЛ, "НаимОрг");
	ИначеЕсли ИП <> Неопределено Тогда
		Результат.ЭтоИП = Истина;
		Результат.ИНН = Атрибут(ИП, "ИННФЛ");
		ФИО = Дочерний(ИП, "ФИО");
		Результат.Наименование = СокрЛП("ИП " + Атрибут(ФИО, "Фамилия") + " " + Атрибут(ФИО, "Имя") + " " + Атрибут(ФИО, "Отчество"));
	ИначеЕсли Ин <> Неопределено Тогда
		Результат.Иностранный = Истина;
		Результат.Наименование = Атрибут(Ин, "НаимОрг");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РеквизитыДокумента(Знач Узел)
	Возврат Новый Структура("Наименование, Номер, Дата",
		Атрибут(Узел, "РеквНаимДок"), Атрибут(Узел, "РеквНомерДок"), ДатаИзСтроки(Атрибут(Узел, "РеквДатаДок")));
КонецФункции

Процедура ПрочитатьИнфПоля(Знач Узел, Поля)
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Текст Из Дочерние(Узел, "ТекстИнф") Цикл
		ДобавитьИнфПоле(Поля, Текст);
	КонецЦикла;
КонецПроцедуры

// Повтор идентификатора (бывает у ИнфПолФХЖ2, например несколько штрихкодов) - значения
// через запятую: так их читает и подключаемый модуль Диадока («Для1С_Штрихкод»).
Процедура ДобавитьИнфПоле(Поля, Знач Узел)
	Ключ = Атрибут(Узел, "Идентиф");
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	Значение = Атрибут(Узел, "Значен");
	Было = Поля.Получить(Ключ);
	Поля.Вставить(Ключ, ?(Было = Неопределено, Значение, Было + "," + Значение));
КонецПроцедуры

// СумНал: число или «без НДС» (БезНДС) - тогда 0.
Функция СуммаНалога(Знач Узел)
	Если Узел = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЧислоИзСтроки(ТекстЭлемента(Дочерний(Узел, "СумНал")));
КонецФункции

#КонецОбласти

#Область XML

Функция ДокументXML(Знач Данные)

	Чтение = Новый ЧтениеXML;
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Чтение.ОткрытьПоток(Данные.ОткрытьПотокДляЧтения());
	Иначе
		Чтение.УстановитьСтроку(Данные);
	КонецЕсли;
	Построитель = Новый ПостроительDOM;
	ДокументDOM = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	Возврат ДокументDOM;

КонецФункции

// Первый дочерний элемент с именем; Неопределено, если нет (в том числе у Неопределено).
Функция Дочерний(Знач Элемент, Знач Имя)
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Узел = Элемент.ПервыйДочерний;
	Пока Узел <> Неопределено Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент И Узел.ИмяЭлемента = Имя Тогда
			Возврат Узел;
		КонецЕсли;
		Узел = Узел.СледующийСоседний;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Дочерние(Знач Элемент, Знач Имя)
	Результат = Новый Массив;
	Если Элемент = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Узел = Элемент.ПервыйДочерний;
	Пока Узел <> Неопределено Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент И Узел.ИмяЭлемента = Имя Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
		Узел = Узел.СледующийСоседний;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Атрибут(Знач Элемент, Знач Имя)
	Если Элемент = Неопределено ИЛИ НЕ Элемент.ЕстьАтрибут(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Элемент.ПолучитьАтрибут(Имя));
КонецФункции

Функция ТекстЭлемента(Знач Элемент)
	Если Элемент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Элемент.ТекстовоеСодержимое);
КонецФункции

#КонецОбласти

#Область Преобразования

Функция ПервыйНепустой(Знач Значение1, Знач Значение2, Знач Значение3 = "")
	Если ЗначениеЗаполнено(Значение1) Тогда
		Возврат Значение1;
	ИначеЕсли ЗначениеЗаполнено(Значение2) Тогда
		Возврат Значение2;
	КонецЕсли;
	Возврат Значение3;
КонецФункции

// Число из атрибута ФНС: разделитель - точка, бывает запятая и пробелы. Пустое или
// нечисловое (например «-» у БезНДС) - 0.
Функция ЧислоИзСтроки(Знач Текст)
	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), ",", ".");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Попытка
		Возврат ОписаниеЧисла.ПривестиЗначение(Число(Текст));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Дата ФНС «ДД.ММ.ГГГГ». Неразборчивая - пустая дата.
Функция ДатаИзСтроки(Знач Текст)
	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ПоступлениеПоУмолчанию

// Реализация по умолчанию для типовой УТ 10.3: поступление товаров и услуг по разобранному УПД.
// Документ не записывается - его пишет ядро после точки ПередЗаписьюДокументаПоВходящему.
// Параметры - см. ЭДО_Сервер.СоздатьДокументПоXML: Разбор, Организация, ДокументОбъект, Сообщения.
// Не найдены контрагент или номенклатура хоть одной строки - документ не создается (список
// несопоставленных строк - в Сообщения); не найден договор - создается с пустым договором.
Процедура ЗаполнитьПоступлениеПоУмолчанию(Параметры) Экспорт

	Если Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") = Неопределено Тогда
		Параметры.Сообщения.Добавить("В конфигурации нет документа «Поступление товаров и услуг»: нужна точка профиля ПриСозданииДокументаПоВходящему");
		Возврат;
	КонецЕсли;
	Разбор = Параметры.Разбор;
	Если Разбор.Продавец = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Разбор.Продавец.ИНН) Тогда
		Параметры.Сообщения.Добавить("В документе не указан ИНН продавца");
		Возврат;
	КонецЕсли;
	Контрагент = КонтрагентПоИНН(Разбор.Продавец.ИНН, Разбор.Продавец.КПП);
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Параметры.Сообщения.Добавить("Не найден контрагент с ИНН " + Разбор.Продавец.ИНН + " (" + Разбор.Продавец.Наименование + ")");
		Возврат;
	КонецЕсли;

	// Строку без номенклатуры конфигурация не записывает (модуль документа читает объект номенклатуры
	// каждой строки), поэтому несопоставленные строки останавливают создание целиком.
	ПродавецНаш = ЗначениеЗаполнено(ОрганизацияПоИНН(Разбор.Продавец.ИНН, ""));
	Сопоставление = СопоставитьНоменклатуру(Разбор.Строки, Контрагент, ПродавецНаш);
	Несопоставленные = 0;
	Номер = 0;
	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		Номер = Номер + 1;
		Если Сопоставление.Получить(Номер) = Неопределено Тогда
			Несопоставленные = Несопоставленные + 1;
			Параметры.Сообщения.Добавить("Строка " + СтрокаУПД.НомерСтроки + " «" + СтрокаУПД.Наименование
				+ "»: номенклатура не сопоставлена (код " + СтрокаУПД.КодТовара
				+ ?(ЗначениеЗаполнено(СтрокаУПД.GTIN), ", GTIN " + СтрокаУПД.GTIN, "") + ")");
		КонецЕсли;
	КонецЦикла;
	Если Несопоставленные > 0 Тогда
		Параметры.Сообщения.Добавить("Не сопоставлено строк: " + Несопоставленные + " из " + Разбор.Строки.Количество()
			+ ". Заполните соответствие номенклатуры поставщика и загрузите документ снова");
		Возврат;
	КонецЕсли;

	Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Документ.Заполнить(Неопределено);   // шапка по умолчанию: склад, подразделение, ответственный пользователя
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Организация = Параметры.Организация;
	Документ.Контрагент = Контрагент;
	Договор = ДоговорПоставщика(Контрагент, Параметры.Организация, Параметры.Сообщения);
	Документ.ДоговорКонтрагента = Договор;
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда
		Валюта = Договор.ВалютаВзаиморасчетов;
	КонецЕсли;
	Документ.ВалютаДокумента = Валюта;
	Документ.КурсВзаиморасчетов = 1;
	Документ.КратностьВзаиморасчетов = 1;
	Документ.УчитыватьНДС = Истина;
	Документ.СуммаВключаетНДС = Истина;   // в УПД стоимость с налогом дана по строке точно
	Документ.НомерВходящегоДокумента = Лев(Разбор.Номер, Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.НомерВходящегоДокумента.Тип.КвалификаторыСтроки.Длина);
	Документ.ДатаВходящегоДокумента = Разбор.Дата;
	ЗаполнитьКакВПрошлыйРаз(Документ, Параметры.Сообщения);
	Документ.Комментарий = СокрЛП("Загружено из Платформы ЭДО: УПД № " + Разбор.Номер + " от "
		+ Формат(Разбор.Дата, "ДФ=dd.MM.yyyy") + ". " + Документ.Комментарий);

	ЕстьШтрихкодыУпаковок = Метаданные.Документы.ПоступлениеТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено;
	Ключ = 0;
	Сумма = 0;
	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		Ключ = Ключ + 1;
		Номенклатура = Сопоставление.Получить(Ключ);
		Товар = Документ.Товары.Добавить();
		Товар.Номенклатура = Номенклатура;
		Товар.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
		Товар.Коэффициент = 1;
		Товар.Количество = СтрокаУПД.Количество;
		Товар.Сумма = СтрокаУПД.СуммаСНДС;
		Товар.СуммаНДС = СтрокаУПД.СуммаНДС;
		Товар.Цена = ?(СтрокаУПД.Количество = 0, 0, Окр(СтрокаУПД.СуммаСНДС / СтрокаУПД.Количество, 2));
		Товар.СтавкаНДС = СтавкаНДСПоТексту(СтрокаУПД.СтавкаНДС);
		Товар.СуммаАкциза = СтрокаУПД.СуммаАкциза;
		Товар.КлючСвязи = Ключ;
		Сумма = Сумма + СтрокаУПД.СуммаСНДС;
		Если ЕстьШтрихкодыУпаковок Тогда
			ДобавитьКодыМаркировки(Документ, СтрокаУПД);
		КонецЕсли;
	КонецЦикла;
	Документ.СуммаДокумента = Сумма;
	Параметры.ДокументОбъект = Документ;

КонецПроцедуры

// Склад и подразделение, которые не подставились по умолчанию (у пользователя регламента или
// служебного пользователя их нет), - из последнего поступления этой организации от этого
// поставщика, а если его нет - из последнего поступления организации.
Процедура ЗаполнитьКакВПрошлыйРаз(Документ, Сообщения)

	Если ЗначениеЗаполнено(Документ.СкладОрдер) И ЗначениеЗаполнено(Документ.Подразделение) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Поступление.СкладОрдер КАК СкладОрдер,
		|	Поступление.Подразделение КАК Подразделение,
		|	ВЫБОР КОГДА Поступление.Контрагент = &Контрагент ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Порядок
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Поступление
		|ГДЕ
		|	Поступление.Проведен
		|	И Поступление.Организация = &Организация
		|	И Поступление.Дата > &Граница
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	Поступление.Дата УБЫВ");
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Запрос.УстановитьПараметр("Контрагент", Документ.Контрагент);
	Запрос.УстановитьПараметр("Граница", ДобавитьМесяц(ТекущаяДатаСеанса(), -6));
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Сообщения.Добавить("Не заполнен склад: нет поступлений организации за полгода, укажите склад");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.СкладОрдер) Тогда
		Документ.СкладОрдер = Выборка.СкладОрдер;
		Сообщения.Добавить("Склад взят из прошлого поступления: " + Строка(Выборка.СкладОрдер) + " - проверьте");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		Документ.Подразделение = Выборка.Подразделение;
	КонецЕсли;

КонецПроцедуры

// Коды маркировки строки как пришли в УПД: КИЗ, групповые и транспортные упаковки. Раскрыть
// упаковку до единиц и связать коды со строками - работа базы (обработки маркировки).
Процедура ДобавитьКодыМаркировки(Документ, Знач СтрокаУПД)
	Для Каждого ИмяСписка Из СтрРазделить("КИЗ,Упаковки,ТранспортныеУпаковки", ",") Цикл
		Для Каждого Код Из СтрокаУПД[ИмяСписка] Цикл
			Документ.ШтрихкодыУпаковок.Добавить().ЗначениеШтрихкода = Код;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Организация базы по ИНН (и КПП, если по ИНН их несколько). Пустая ссылка - не наша.
Функция ОрганизацияПоИНН(Знач ИНН, Знач КПП) Экспорт
	Возврат СсылкаПоИНН("Организации", ИНН, КПП);
КонецФункции

Функция КонтрагентПоИНН(Знач ИНН, Знач КПП) Экспорт
	Возврат СсылкаПоИНН("Контрагенты", ИНН, КПП);
КонецФункции

Функция СсылкаПоИНН(Знач ИмяСправочника, Знач ИНН, Знач КПП)

	ИНН = СокрЛП(ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьГруппы = Метаданные.Справочники[ИмяСправочника].Иерархический;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка,
		|	Спр.КПП КАК КПП
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Спр
		|ГДЕ
		|	Спр.ИНН = &ИНН
		|	И НЕ Спр.ПометкаУдаления" + ?(ЕстьГруппы, "
		|	И НЕ Спр.ЭтоГруппа", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Спр.Код");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(КПП) Тогда
		Найденная = Таблица.Найти(СокрЛП(КПП), "КПП");
		Если Найденная <> Неопределено Тогда
			Возврат Найденная.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Таблица[0].Ссылка;

КонецФункции

// Договор с поставщиком: основной договор контрагента, если он подходит, иначе единственный,
// иначе последний по дате - с замечанием, что выбран не однозначно.
Функция ДоговорПоставщика(Знач Контрагент, Знач Организация, Сообщения)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.Организация = &Организация
		|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
		|	И НЕ Договоры.ПометкаУдаления
		|	И НЕ Договоры.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Договоры.Дата УБЫВ");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Договоры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Договоры.Количество() = 0 Тогда
		Сообщения.Добавить("Нет договора с поставщиком " + Строка(Контрагент) + " у организации " + Строка(Организация));
		Возврат Неопределено;
	КонецЕсли;
	Основной = Контрагент.ОсновнойДоговорКонтрагента;
	Если Договоры.Найти(Основной) <> Неопределено Тогда
		Возврат Основной;
	КонецЕсли;
	Если Договоры.Количество() > 1 Тогда
		Сообщения.Добавить("У поставщика несколько договоров, выбран " + Строка(Договоры[0]) + " - проверьте");
	КонецЕсли;
	Возврат Договоры[0];

КонецФункции

// Номенклатура строк УПД, одним пакетом запросов на документ. Порядок поиска: соответствие
// номенклатуры контрагента (код, идентификатор, артикул, штрихкод, наименование), штрихкоды
// базы (GTIN и «Для1С_Штрихкод» из ИнфПолФХЖ2), а если продавец - своя организация, код
// номенклатуры (КодТов в нашем же УПД - наш код).
// Возврат: Соответствие (номер строки по порядку, с 1 -> номенклатура). Не найденных нет в ответе.
Функция СопоставитьНоменклатуру(Знач СтрокиУПД, Знач Контрагент, Знач ПродавецНаш) Экспорт

	Итог = Новый Соответствие;
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Ключи.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	Ключи.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Ключи.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Номер = 0;
	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		Номер = Номер + 1;
		Приоритет = 0;
		Для Каждого Поиск Из ПоляПоискаНоменклатурыКонтрагента(СтрокаУПД) Цикл
			Приоритет = Приоритет + 1;
			Если ЗначениеЗаполнено(Поиск.Значение) Тогда
				НоваяСтрока = Ключи.Добавить();
				НоваяСтрока.Ключ = Номер;
				НоваяСтрока.Приоритет = Приоритет;
				НоваяСтрока.Поле = Поиск.Поле;
				НоваяСтрока.Значение = Поиск.Значение;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Код Из ШтрихкодыСтроки(СтрокаУПД) Цикл
			НоваяСтрока = Ключи.Добавить();
			НоваяСтрока.Ключ = Номер;
			НоваяСтрока.Приоритет = 10;
			НоваяСтрока.Поле = "Штрихкод";
			НоваяСтрока.Значение = Код;
		КонецЦикла;
		Если ПродавецНаш И ЗначениеЗаполнено(СтрокаУПД.КодТовара) Тогда
			НоваяСтрока = Ключи.Добавить();
			НоваяСтрока.Ключ = Номер;
			НоваяСтрока.Приоритет = 20;
			НоваяСтрока.Поле = "Код";
			НоваяСтрока.Значение = СтрокаУПД.КодТовара;
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Части = Новый Массив;
	РС = Метаданные.РегистрыСведений.Найти("НоменклатураКонтрагентов");
	Если РС <> Неопределено Тогда
		Для Каждого Поиск Из ПоляПоискаНоменклатурыКонтрагента(СтрокиУПД[0]) Цикл
			Если РС.Ресурсы.Найти(Поиск.Поле) <> Неопределено Тогда
				Части.Добавить(
					"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, Соответствие.Номенклатура КАК Номенклатура
					|ИЗ ВТКлючи КАК К
					|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураКонтрагентов КАК Соответствие
					|	ПО Соответствие.Контрагент = &Контрагент
					|		И К.Поле = """ + Поиск.Поле + """
					|		И ВЫРАЗИТЬ(Соответствие." + Поиск.Поле + " КАК СТРОКА(150)) = К.Значение
					|ГДЕ Соответствие.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Метаданные.РегистрыСведений.Найти("Штрихкоды") <> Неопределено Тогда
		Части.Добавить(
			"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, ВЫРАЗИТЬ(Штрихкоды.Владелец КАК Справочник.Номенклатура) КАК Номенклатура
			|ИЗ ВТКлючи КАК К
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
			|	ПО К.Поле = ""Штрихкод""
			|		И Штрихкоды.Штрихкод = К.Значение
			|		И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура");
	КонецЕсли;
	Части.Добавить(
		"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, Спр.Ссылка КАК Номенклатура
		|ИЗ ВТКлючи КАК К
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Спр
		|	ПО К.Поле = ""Код""
		|		И Спр.Код = К.Значение
		|ГДЕ НЕ Спр.ЭтоГруппа И НЕ Спр.ПометкаУдаления");

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ключи.Ключ КАК Ключ, Ключи.Приоритет КАК Приоритет, Ключи.Поле КАК Поле, Ключи.Значение КАК Значение
		|ПОМЕСТИТЬ ВТКлючи
		|ИЗ &Ключи КАК Ключи
		|;
		|ВЫБРАТЬ Найденные.Ключ КАК Ключ, Найденные.Приоритет КАК Приоритет, Найденные.Номенклатура КАК Номенклатура
		|ИЗ (" + СтрСоединить(Части, "
		|ОБЪЕДИНИТЬ ВСЕ
		|") + ") КАК Найденные
		|УПОРЯДОЧИТЬ ПО Ключ, Приоритет");
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Итог.Получить(Выборка.Ключ) = Неопределено И ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Итог.Вставить(Выборка.Ключ, Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ПоляПоискаНоменклатурыКонтрагента(Знач СтрокаУПД)
	Поля = Новый Массив;
	Поля.Добавить(Новый Структура("Поле, Значение", "КодНоменклатурыКонтрагента", СтрокаУПД.КодТовара));
	Поля.Добавить(Новый Структура("Поле, Значение", "Идентификатор", СтрокаУПД.КодТовара));
	Поля.Добавить(Новый Структура("Поле, Значение", "АртикулНоменклатурыКонтрагента", СтрокаУПД.Артикул));
	Поля.Добавить(Новый Структура("Поле, Значение", "ШтрихКодНоменклатурыКонтрагента", СтрокаУПД.GTIN));
	Поля.Добавить(Новый Структура("Поле, Значение", "НаименованиеНоменклатурыКонтрагента", СтрокаУПД.Наименование));
	Возврат Поля;
КонецФункции

// Штрихкоды строки для поиска: GTIN (и без ведущих нулей - в базе EAN-13 хранят 13 знаков)
// и значения ИнфПолФХЖ2 «Для1С_Штрихкод» через запятую.
Функция ШтрихкодыСтроки(Знач СтрокаУПД)
	Коды = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаУПД.GTIN) Тогда
		Коды.Добавить(СтрокаУПД.GTIN);
		Если СтрДлина(СтрокаУПД.GTIN) = 14 И Лев(СтрокаУПД.GTIN, 1) = "0" Тогда
			Коды.Добавить(Сред(СтрокаУПД.GTIN, 2));
		КонецЕсли;
	КонецЕсли;
	Значение = СтрокаУПД.ИнфПоля.Получить("Для1С_Штрихкод");
	Если ЗначениеЗаполнено(Значение) Тогда
		Для Каждого Код Из СтрРазделить(Значение, ",", Ложь) Цикл
			Коды.Добавить(СокрЛП(Код));
		КонецЦикла;
	КонецЕсли;
	Возврат Коды;
КонецФункции

// Ставка НДС по тексту УПД: «22%» - НДС22, «22/122» - НДС22_122, «без НДС» - БезНДС.
// Ставки, которой нет в перечислении базы, - пустая (заполнит человек).
Функция СтавкаНДСПоТексту(Знач Текст) Экспорт
	Текст = НРег(СтрЗаменить(СокрЛП(Текст), " ", ""));
	Если СтрНайти(Текст, "без") > 0 Тогда
		Имя = "БезНДС";
	ИначеЕсли СтрНайти(Текст, "/") > 0 Тогда
		Имя = "НДС" + СтрЗаменить(СтрЗаменить(Текст, "%", ""), "/", "_");
	Иначе
		Имя = "НДС" + СтрЗаменить(Текст, "%", "");
	КонецЕсли;
	Если Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Найти(Имя) = Неопределено Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС[Имя];
КонецФункции

#КонецОбласти
