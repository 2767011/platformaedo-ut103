////////////////////////////////////////////////////////////////////////////////
// ЭДО_ПрофильБазы — профиль конкретной базы для расширения «Платформа ЭДО».
// Реализует контракт точек расширения ядра (ЭДО_Сервер.ВерсияКонтрактаПрофиля).
//
// Профиль базы КТ2000 «Управление торговлей алкогольной продукцией» 10.3.23.2.
// Здесь только то, чего в типовой УТ 10.3 нет вовсе:
//   ТЧ КИЗ у реализации (коды маркировки, связь по КлючСвязи, тип сборки, групповые упаковки),
//   регистр лионСтатусыДокументовЭДО как источник готовности (мост в модуле набора записей),
//   свойства ЭДО_Орг* с ФИО подписанта организации.
// Вариации самой типовой (отсутствующий реквизит маркировки, имена видов контактной
// информации) определяет ядро — переносить их сюда нельзя.
////////////////////////////////////////////////////////////////////////////////

#Область ТочкиКонтракта

// Редакция контракта точек расширения, под которую написан профиль.
Функция ВерсияКонтракта() Экспорт
	Возврат 1;
КонецФункции

// Точка 1. Дополнительные условия готовности документа.
// Параметры: Ссылка, Готов, Причина, ОтправкаНеТребуется.
Процедура ПриПроверкеГотовности(Параметры) Экспорт

	Если НЕ Параметры.Готов Тогда
		Возврат;
	КонецЕсли;
	Ссылка = Параметры.Ссылка;

	// Без отметки «Подготовлен к отправке» из путевого листа документ не уходит НИКОГДА.
	// Ядро само отправляет непомеченные по страховке через N дней, а выключить страховку
	// нельзя: ноль в настройке ядро читает как «не задано» и берёт умолчание 3 дня.
	// Для нас страховка вредна — накладная без отметки означает, что рейс ещё не собран.
	Если НЕ ПометкаКОтправкеСтоит(Ссылка) Тогда
		Параметры.Готов = Ложь;
		Параметры.Причина = "Нет отметки «Подготовлен к отправке» — её ставит кнопка в путевом листе";
		Возврат;
	КонецЕсли;

	// Без ФИО подписанта движок собирает документ без узла Подписант и падает внутри.
	Если НЕ ПодписантОрганизацииЗаполнен(Ссылка.Организация) Тогда
		Параметры.Готов = Ложь;
		Параметры.Причина = "У организации «" + Строка(Ссылка.Организация)
			+ "» не заполнены свойства подписанта ЭДО_ОргФамилия / ЭДО_ОргИмя";
	КонецЕсли;

КонецПроцедуры

// Точка 2. Запрос списка документов на отправку. Параметры: Текст.
Процедура ПриФормированииНастройкиКонфигурации(Параметры) Экспорт

	Текст = Параметры.Текст;

	// Колонка «Маркировка» — по наличию строк ТЧ КИЗ.
	// ⚠️ Соединение по паре (Ссылка, НомерСтроки = 1) — попадание в кластерный индекс ТЧ.
	//    Вариант с РАЗЛИЧНЫЕ по всей ТЧ на этой базе стоит 40 секунд против 20 мс.
	Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("КИЗ") <> Неопределено Тогда
		Текст = СтрЗаменить(Текст,
			"ЛОЖЬ КАК ДокументСодержитМаркируемыйТовар",
			"ВЫБОР КОГДА ПерваяСтрокаКИЗ.Ссылка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ДокументСодержитМаркируемыйТовар");
		Текст = СтрЗаменить(Текст,
			"И (Свойство_ЭДО_ИдентификаторАбонента.Свойство = &amp;СвойствоИдентификаторАбонента)",
			"И (Свойство_ЭДО_ИдентификаторАбонента.Свойство = &amp;СвойствоИдентификаторАбонента)"
				+ Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.КИЗ КАК ПерваяСтрокаКИЗ"
				+ Символы.ПС + "ПО ПерваяСтрокаКИЗ.Ссылка = РеализацияТоваровУслуг.Ссылка"
				+ Символы.ПС + "И ПерваяСтрокаКИЗ.НомерСтроки = 1");
	КонецЕсли;

	Параметры.Текст = Текст;

КонецПроцедуры

// Точка 3. Настройка реализации: своих отличий у этой базы нет.
Процедура ПриФормированииНастройкиРеализации(Параметры) Экспорт
	Возврат;
КонецПроцедуры

// Точка 5. Отбор очереди регламента: остаются только документы с отметкой из путевого листа.
// Параметры: НижняяГраница, Лимит, Документы (таблица Ссылка, Номер, Дата), Перехвачено.
// Типовой отбор ядра уже применил свой гейт готовности, но вместе со страховкой по возрасту —
// см. ПриПроверкеГотовности, почему страховка для этой базы не годится.
Процедура ПриОтбореДокументовКОтправке(Параметры) Экспорт

	// ⚠️ Не называть переменную «Документы»: это глобальный менеджер, присваивание падает
	//    «Поле объекта недоступно для записи».
	Очередь = Параметры.Документы;
	Если Очередь.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ссылки = Очередь.ВыгрузитьКолонку("Ссылка");
	Помеченные = ПомеченныеКОтправке(Ссылки);
	Индекс = Очередь.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Помеченные.Получить(Очередь[Индекс].Ссылка) = Неопределено Тогда
			Очередь.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Точка 4. Коды маркировки — то, что декларативный движок не выгружает.
// Параметры: Ссылка, Текст.
Процедура ПриФормированииXML(Параметры) Экспорт
	Параметры.Текст = ДополнитьНомСредИдентТов(Параметры.Текст, Параметры.Ссылка);
КонецПроцедуры

// Точка, необязательная. Ручная проверка кодов маркировки в Честном знаке по кнопке
// разбора: ничего не меняет в документах и не влияет на отправку, только показ.
// Параметры: Ссылки (Массив документов), Результат (Структура Поддержано, Текст, Всего, Ошибок) —
// ядро уже создало Результат с умолчанием "не поддержано", здесь его надо заполнить по-настоящему.
Процедура ПриПроверкеКодовМаркировки(Параметры) Экспорт

	Если Метаданные.ОбщиеМодули.Найти("лионИнтеграцияЧестныйЗнак") = Неопределено Тогда
		// Модуль наш, не вендорский — есть только в базах, куда его ставили. Без него
		// сказать нечего, и это не ошибка профиля, а нормальное состояние базы.
		Параметры.Результат.Текст = "Модуль лионИнтеграцияЧестныйЗнак не подключен в этой базе";
		Возврат;
	КонецЕсли;

	СтрокиОтчета = Новый Массив;
	Всего = 0;
	Ошибок = 0;
	Для Каждого Ссылка Из Параметры.Ссылки Цикл
		Попытка
			ОтчетПоДокументу = ОтчетПроверкиКодовДокумента(Ссылка);
		Исключение
			Ошибок = Ошибок + 1;
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СтрокиОтчета.Добавить("Документ " + Строка(Ссылка) + ": ошибка проверки — " + ТекстОшибки);
			Продолжить;
		КонецПопытки;
		Всего = Всего + ОтчетПоДокументу.Всего;
		СтрокиОтчета.Добавить(ОтчетПоДокументу.Текст);
	КонецЦикла;

	Параметры.Результат.Поддержано = Истина;
	Параметры.Результат.Всего = Всего;
	Параметры.Результат.Ошибок = Ошибок;
	Параметры.Результат.Текст = СтрСоединить(СтрокиОтчета, Символы.ПС + Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область РеализацияПрофиля

// Стоит ли у документа пометка ядра ЭДО_ПометкаКОтправке. Пометку ставит мост в модуле
// набора записей регистра лионСтатусыДокументовЭДО по статусу «Подготовлен к отправке».
Функция ПометкаКОтправкеСтоит(Ссылка) Экспорт
	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Возврат ПомеченныеКОтправке(Ссылки).Получить(Ссылка) <> Неопределено;
КонецФункции

// Соответствие «ссылка → Истина» для документов из массива, у которых пометка стоит.
// Пометка хранится как Булево, но старые записи могли лечь строкой — принимаем оба вида,
// как это делает ядро в своём отборе.
Функция ПомеченныеКОтправке(Ссылки) Экспорт
	Результат = Новый Соответствие;
	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_ПометкаКОтправке");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() ИЛИ Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЗС.Объект КАК Объект
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗС
		|ГДЕ ЗС.Свойство = &Свойство
		|	И ЗС.Объект В (&Ссылки)
		|	И (ВЫРАЗИТЬ(ЗС.Значение КАК БУЛЕВО) = ИСТИНА
		|		ИЛИ ВЫРАЗИТЬ(ЗС.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1""))");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Объект, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Заполнены ли у организации ФИО подписанта (свойства ЭДО_Орг*).
Функция ПодписантОрганизацииЗаполнен(Организация) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЗС.Свойство.Наименование КАК Имя, ЗС.Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗС
		|ГДЕ ЗС.Объект = &Объект И ЗС.Свойство.Наименование В (""ЭДО_ОргФамилия"", ""ЭДО_ОргИмя"")");
	Запрос.УстановитьПараметр("Объект", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Заполнено = 0;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка(Выборка.Значение))) Тогда
			Заполнено = Заполнено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Заполнено = 2;
КонецФункции

// Коды маркировки документа: Соответствие «номер строки товара → Структура».
// Структура строки: ТипСборки (Строка), Коды (Массив), Коробки (Массив), Паллеты (Массив).
// Отбираются только виды продукции с обязательным экземплярным учётом на дату документа
// (регистр НастройкиУчетаМаркируемойПродукцииИСМП). Товары на объёмно-сортовом учёте (ОСУ)
// кодов в УПД не несут — это штатная ситуация, а не потеря данных.
// ⚠️ Нетиповая часть КТ2000: ТЧ КИЗ, связка строк по КлючСвязи, перечисление типов сборки.
Функция КодыМаркировкиПоСтрокам(Ссылка) Экспорт

	Результат = Новый Соответствие;
	Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("КИЗ") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.НомерСтроки КАК НомерСтроки,
		|	ПРЕДСТАВЛЕНИЕ(Т.ТипСборки) КАК ТипСборки,
		|	К.КИЗ КАК Код,
		|	К.НомерКоробки КАК НомерКоробки,
		|	К.НомерПаллеты КАК НомерПаллеты
		|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.КИЗ КАК К
		|	ПО К.Ссылка = Т.Ссылка И К.КлючСвязи = Т.КлючСвязи
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|	И К.КИЗ <> """"
		|	И Т.Номенклатура.ВидНоменклатуры.ВидыПродукцииИС В
		|		(ВЫБРАТЬ Н.ВидПродукции ИЗ РегистрСведений.НастройкиУчетаМаркируемойПродукцииИСМП КАК Н
		|			ГДЕ Н.ВестиУчетПродукции И Н.ДатаОбязательногоЭкземплярногоУчета <= &Дата)
		|УПОРЯДОЧИТЬ ПО НомерСтроки");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", Ссылка.Дата);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Результат[Выборка.НомерСтроки];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ТипСборки, Коды, Коробки, Паллеты",
				СокрЛП(Строка(Выборка.ТипСборки)), Новый Массив, Новый Массив, Новый Массив);
			Результат.Вставить(Выборка.НомерСтроки, Данные);
		КонецЕсли;
		Данные.Коды.Добавить(СокрЛП(Строка(Выборка.Код)));
		Коробка = СокрЛП(Строка(Выборка.НомерКоробки));
		Если ЗначениеЗаполнено(Коробка) И Данные.Коробки.Найти(Коробка) = Неопределено Тогда
			Данные.Коробки.Добавить(Коробка);
		КонецЕсли;
		Паллета = СокрЛП(Строка(Выборка.НомерПаллеты));
		Если ЗначениеЗаполнено(Паллета) И Данные.Паллеты.Найти(Паллета) = Неопределено Тогда
			Данные.Паллеты.Добавить(Паллета);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Узлы НомСредИдентТов для одной строки товара — правила сняты с подключаемого модуля
// Контур.Диадок (разбор — топик marking-utap банка lion):
//   контрагент без ЧЗОтправкаГрупповыхУпаковок → все коды поштучно;
//   «Коробки» → номера коробок в <НомУпак>, сами коды не выгружаются;
//   «Паллеты» → по узлу на паллету, только атрибут ИдентТрансУпак;
//   «Штучно» и незаполненный тип → поштучно.
Функция УзлыКодовСтроки(Знач Данные, Знач ГрупповыеУпаковки)

	Узлы = "";

	Если ГрупповыеУпаковки И Данные.ТипСборки = "Коробки" И Данные.Коробки.Количество() > 0 Тогда
		Узлы = "<НомСредИдентТов>";
		Для Каждого Коробка Из Данные.Коробки Цикл
			Узлы = Узлы + "<НомУпак>" + ЭкранироватьXML(Коробка) + "</НомУпак>";
		КонецЦикла;
		Узлы = Узлы + "</НомСредИдентТов>";

	ИначеЕсли ГрупповыеУпаковки И Данные.ТипСборки = "Паллеты" И Данные.Паллеты.Количество() > 0 Тогда
		Для Каждого Паллета Из Данные.Паллеты Цикл
			Узлы = Узлы + "<НомСредИдентТов ИдентТрансУпак=""" + ЭкранироватьXML(Паллета) + """/>";
		КонецЦикла;

	ИначеЕсли Данные.Коды.Количество() > 0 Тогда
		Узлы = "<НомСредИдентТов>";
		Для Каждого Код Из Данные.Коды Цикл
			Узлы = Узлы + "<КИЗ>" + ЭкранироватьXML(Код) + "</КИЗ>";
		КонецЦикла;
		Узлы = Узлы + "</НомСредИдентТов>";
	КонецЕсли;

	Возврат Узлы;

КонецФункции

// Дописать в готовый XML узлы <НомСредИдентТов><КИЗ>…</КИЗ></НомСредИдентТов> по строкам товара.
// ⚠️ Почему постобработкой, а не маппингом: декларативный движок не выгружает простые
//    unbounded-элементы внутри строки — той же болезнью лечился КрНаимСтрПр (см. рядом).
// Реализованы все три ветки: поштучно, коробки (НомУпак) и паллеты (ИдентТрансУпак).
Функция ДополнитьНомСредИдентТов(Знач Текст, Ссылка) Экспорт

	КодыПоСтрокам = КодыМаркировкиПоСтрокам(Ссылка);
	Если КодыПоСтрокам.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	ГрупповыеУпаковки = Ложь;
	Если Метаданные.Справочники.Контрагенты.Реквизиты.Найти("ЧЗОтправкаГрупповыхУпаковок") <> Неопределено Тогда
		ГрупповыеУпаковки = Ссылка.Контрагент.ЧЗОтправкаГрупповыхУпаковок;
	КонецЕсли;

	Маркер = "<СведТов ";
	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл
		Поз = СтрНайти(Остаток, Маркер);
		Если Поз = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Результат = Результат + Лев(Остаток, Поз - 1) + Маркер;
		Хвост = Сред(Остаток, Поз + СтрДлина(Маркер));

		// номер строки берём из самого XML: движок проставляет НомСтр по строке товара
		НомерСтроки = 0;
		ПозНом = СтрНайти(Хвост, "НомСтр=""");
		Если ПозНом > 0 Тогда
			ПослеНом = Сред(Хвост, ПозНом + 8);
			ПозКавычки = СтрНайти(ПослеНом, """");
			Если ПозКавычки > 1 Тогда
				Попытка
					НомерСтроки = Число(Лев(ПослеНом, ПозКавычки - 1));
				Исключение
					НомерСтроки = 0;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		Данные = ?(НомерСтроки = 0, Неопределено, КодыПоСтрокам[НомерСтроки]);
		ПозДоп = СтрНайти(Хвост, "<ДопСведТов");
		Узел = ?(Данные = Неопределено, "", УзлыКодовСтроки(Данные, ГрупповыеУпаковки));
		Если НЕ ЗначениеЗаполнено(Узел) ИЛИ ПозДоп = 0 Тогда
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		ЧастьДо = Лев(Хвост, ПозДоп - 1);
		ОстХвост = Сред(Хвост, ПозДоп);
		КонецТега = СтрНайти(ОстХвост, ">");
		Если КонецТега = 0 Тогда
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;
		Открывающий = Лев(ОстХвост, КонецТега);
		ПослеТега = Сред(ОстХвост, КонецТега + 1);
		Если Прав(Открывающий, 2) = "/>" Тогда
			// <ДопСведТов ... /> — раскрываем в пару тегов
			Открывающий = Лев(Открывающий, СтрДлина(Открывающий) - 2) + ">";
			Вставка = Узел + "</ДопСведТов>";
			Результат = Результат + ЧастьДо + Открывающий + Вставка;
			Остаток = ПослеТега;
		Иначе
			// узел уже открыт: НомСредИдентТов по схеме идёт последним из того, что мы пишем,
			// поэтому вставляем перед закрывающим </ДопСведТов>
			ПозЗакр = СтрНайти(ПослеТега, "</ДопСведТов>");
			Если ПозЗакр = 0 Тогда
				Результат = Результат + ЧастьДо + Открывающий;
				Остаток = ПослеТега;
			Иначе
				Результат = Результат + ЧастьДо + Открывающий + Лев(ПослеТега, ПозЗакр - 1) + Узел;
				Остаток = Сред(ПослеТега, ПозЗакр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Минимальное экранирование для значения, которое кладём в XML-элемент.
Функция ЭкранироватьXML(Знач Значение)
	Значение = СтрЗаменить(Значение, "&", "&amp;");
	Значение = СтрЗаменить(Значение, "<", "&lt;");
	Значение = СтрЗаменить(Значение, ">", "&gt;");
	Возврат Значение;
КонецФункции

// Проверка кодов ОДНОГО документа в Честном знаке для точки ПриПроверкеКодовМаркировки.
// Категории те же, что применяет Диадок при выгрузке (см. ДополнитьНомСредИдентТов и топик
// marking-utap): владелец кода не совпадает с организацией документа — "чужой", владелец
// свой, но статус не INTRODUCED — "не в обороте", кода нет в ответе ЧЗ — "нет в Честном знаке".
// Возврат: Структура(Текст Строка, Всего Число).
Функция ОтчетПроверкиКодовДокумента(Знач Ссылка)

	КодыПоСтрокам = КодыМаркировкиПоСтрокам(Ссылка);
	МассивКодов = Новый Массив;
	Для Каждого КлючЗначение Из КодыПоСтрокам Цикл
		Для Каждого Код Из КлючЗначение.Значение.Коды Цикл
			Если МассивКодов.Найти(Код) = Неопределено Тогда
				МассивКодов.Добавить(Код);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если МассивКодов.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, Всего",
			"Документ " + ЗаголовокДокумента(Ссылка) + Символы.ПС + "  кодов маркировки нет", 0);
	КонецЕсли;

	// Свой общий модуль, есть не в каждой базе - проверка на существование уже сделана
	// в вызывающей процедуре, но сам вызов все равно в Попытке: мало ли, сменится сигнатура.
	// ⚠️ Выполнить - ОПЕРАТОР, его результат присвоить нельзя: значение возвращает Вычислить.
	// Через них же вызов и идёт, потому что имени модуля нет в базах без маркировки,
	// и прямое обращение не дало бы расширению собраться.
	Попытка
		Сведения = Вычислить("лионИнтеграцияЧестныйЗнак.ПолучитьИнформациюКМ(МассивКодов)");
	Исключение
		ВызватьИсключение "Обращение в Честный знак: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ПоКоду = Новый Соответствие;
	Для Каждого Сведение Из Сведения Цикл
		ПоКоду.Вставить(Сведение.cis, Сведение);
	КонецЦикла;

	ИННДокумента = СокрЛП(Ссылка.Организация.ИНН);
	НаименованиеОрганизации = Строка(Ссылка.Организация);

	ВПорядке = 0;
	НеВОбороте = Новый Массив;
	НетВЧЗ = Новый Массив;
	ЧужиеПоВладельцу = Новый Соответствие; // ключ "ИНН|Наименование" -> Массив строк вида (Код, Товар)

	Для Каждого Код Из МассивКодов Цикл
		Сведение = ПоКоду.Получить(Код);
		Если Сведение = Неопределено Тогда
			НетВЧЗ.Добавить(Код);
			Продолжить;
		КонецЕсли;

		ВладелецИНН = СокрЛП(Сведение.ownerInn);
		Если ВладелецИНН <> ИННДокумента Тогда
			Ключ = ВладелецИНН + "|" + СокрЛП(Сведение.ownerName);
			Список = ЧужиеПоВладельцу.Получить(Ключ);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ЧужиеПоВладельцу.Вставить(Ключ, Список);
			КонецЕсли;
			Список.Добавить(Новый Структура("Код, Товар", Код, СокрЛП(Сведение.productName)));
		ИначеЕсли ВРег(СокрЛП(Сведение.status)) <> "INTRODUCED" Тогда
			НеВОбороте.Добавить(Новый Структура("Код, Товар", Код, СокрЛП(Сведение.productName)));
		Иначе
			ВПорядке = ВПорядке + 1;
		КонецЕсли;
	КонецЦикла;

	ВсегоЧужих = 0;
	Для Каждого КлючЗначение Из ЧужиеПоВладельцу Цикл
		ВсегоЧужих = ВсегоЧужих + КлючЗначение.Значение.Количество();
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить("Документ " + ЗаголовокДокумента(Ссылка));
	Строки.Добавить("  кодов: " + МассивКодов.Количество() + ", в порядке: " + ВПорядке);

	Если ВсегоЧужих > 0 Тогда
		Для Каждого КлючЗначение Из ЧужиеПоВладельцу Цикл
			ЧастиКлюча = СтрРазделить(КлючЗначение.Ключ, "|", Истина);
			КоличествоЧужих = КлючЗначение.Значение.Количество();
			Строки.Добавить("  чужие (" + КоличествоЧужих + "): владелец "
				+ ЧастиКлюча[1] + " (ИНН " + ЧастиКлюча[0] + "), а документ от " + НаименованиеОрганизации);
			ДобавитьСтрокиКодов(Строки, КлючЗначение.Значение);
		КонецЦикла;
	Иначе
		Строки.Добавить("  чужие (0)");
	КонецЕсли;

	Строки.Добавить("  не в обороте (" + НеВОбороте.Количество() + ")");
	ДобавитьСтрокиКодов(Строки, НеВОбороте);

	Если НетВЧЗ.Количество() = 0 Тогда
		Строки.Добавить("  нет в Честном знаке (0)");
	Иначе
		Строки.Добавить("  нет в Честном знаке (" + НетВЧЗ.Количество() + ")");
		Для Каждого Код Из НетВЧЗ Цикл
			Строки.Добавить("     " + УсеченныйКод(Код));
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Текст, Всего", СтрСоединить(Строки, Символы.ПС), МассивКодов.Количество());

КонецФункции

// Строки "код — товар" под заголовком категории, не больше ДопустимоеЧислоСтрокКатегории() штук,
// иначе документ с сотнями чужих кодов превращает окно предупреждения в простыню.
Процедура ДобавитьСтрокиКодов(Строки, Знач Элементы)
	Показано = 0;
	Для Каждого Элемент Из Элементы Цикл
		Если Показано >= ДопустимоеЧислоСтрокКатегории() Тогда
			Строки.Добавить("     …ещё " + (Элементы.Количество() - Показано));
			Возврат;
		КонецЕсли;
		Строки.Добавить("     " + УсеченныйКод(Элемент.Код) + " — " + Элемент.Товар);
		Показано = Показано + 1;
	КонецЦикла;
КонецПроцедуры

Функция ДопустимоеЧислоСтрокКатегории()
	Возврат 20;
КонецФункции

// "№1234 от 01.09.2026" — без времени, оно для разбора не нужно.
Функция ЗаголовокДокумента(Ссылка)
	Возврат "№" + Ссылка.Номер + " от " + Формат(Ссылка.Дата, "ДЛФ=DD");
КонецФункции

Функция ДлинаОбрезкиКода()
	Возврат 30;
КонецФункции

// Длинный код (с криптохвостом) на экране предупреждения превращается в простыню — показываем
// только начало, этого хватает, чтобы опознать код и найти его в документе.
Функция УсеченныйКод(Знач Код)
	Длина = ДлинаОбрезкиКода();
	Если СтрДлина(Код) > Длина Тогда
		Возврат Лев(Код, Длина) + "…";
	КонецЕсли;
	Возврат Код;
КонецФункции

#КонецОбласти
