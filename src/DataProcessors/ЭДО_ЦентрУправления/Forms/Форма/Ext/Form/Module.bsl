////////////////////////////////////////////////////////////////////////////////
// Центр управления ЭДО: рабочее место разбора.
//
// Форма показывает, переключает и зовет действия. Все показатели считает ЭДО_Витрина,
// действия (снятие паузы, ручная отправка) выполняет ЭДО_Сервер: дублировать здесь отбор
// или логику отправки нельзя, иначе витрина, карточка и очередь разойдутся молча.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период = ЭДО_Витрина.ПериодПоУмолчанию();
	НачалоПериода = Период.Начало;
	КонецПериода = Период.Конец;

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	ЗаполнитьДанные();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанные()

	Сводка = ЭДО_Витрина.СводкаИсходящих(НачалоПериода, КонецПериода, ОтборОрганизация);
	ЗагрузитьВТаблицу(Состояния, Сводка);
	ЗагрузитьВТаблицу(ИтогиГрупп, ЭДО_Витрина.ИтогиПоГруппам(Сводка));
	ЗагрузитьВТаблицу(Контур, ЭДО_Витрина.СводкаКонтура());
	ЗагрузитьВТаблицу(Контрагенты, ЭДО_Витрина.СводкаКонтрагентов(НачалоПериода, КонецПериода));
	ЗагрузитьВТаблицу(Организации, ЭДО_Витрина.СводкаОрганизаций(НачалоПериода, КонецПериода));

	Документы.Очистить();
	СписокКонтрагентов.Очистить();
	ТекстРазбора = "Выберите строку на дашборде";
	Элементы.НадписьРазбор.Заголовок = ТекстРазбора;

	ТекстПосчитано = "Рассчитано " + Формат(ТекущаяДата(), "ДЛФ=DT");
	Элементы.НадписьПосчитано.Заголовок = ТекстПосчитано;

КонецПроцедуры

// Построчная загрузка вместо ЗначениеВРеквизитФормы: у части таблиц витрины колонки
// нетипизированы, и загрузка целиком упирается в несовпадение описаний типов.
&НаСервере
Процедура ЗагрузитьВТаблицу(ТаблицаФормы, Знач Данные)

	ТаблицаФормы.Очистить();
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаФормы.Добавить(), СтрокаДанных);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИтоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаИтогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьДокументыГруппы(ТекущиеДанные.Группа);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСостоянийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаСостояний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьДокументыСостояния(ТекущиеДанные.Состояние);

КонецПроцедуры

&НаСервере
Процедура ПоказатьДокументыГруппы(Знач Группа)

	СписокСостояний = Новый Массив;
	Для Каждого СтрокаСводки Из Состояния Цикл
		Если СтрокаСводки.Группа = Группа Тогда
			СписокСостояний.Добавить(СтрокаСводки.Состояние);
		КонецЕсли;
	КонецЦикла;

	Данные = ЭДО_Витрина.ДокументыПоСостояниям(СписокСостояний, НачалоПериода, КонецПериода, ОтборОрганизация);
	ЗагрузитьВТаблицу(Документы, Данные);
	ЗаполнитьПричиныОтказа();
	ПоказатьРазбор("Группа: " + Группа, Истина);

КонецПроцедуры

&НаСервере
Процедура ПоказатьДокументыСостояния(Знач Состояние)

	Данные = ЭДО_Витрина.ДокументыПоСостоянию(Состояние, НачалоПериода, КонецПериода, ОтборОрганизация);
	ЗагрузитьВТаблицу(Документы, Данные);
	ЗаполнитьПричиныОтказа();
	ПоказатьРазбор("Состояние: " + Состояние, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПризнаковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаПризнаков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьКонтрагентовПризнака(ТекущиеДанные.Признак);

КонецПроцедуры

&НаСервере
Процедура ПоказатьКонтрагентовПризнака(Знач Признак)

	Данные = ЭДО_Витрина.КонтрагентыПоПризнаку(Признак, НачалоПериода, КонецПериода);
	ЗагрузитьВТаблицу(СписокКонтрагентов, Данные);
	ПоказатьРазбор("Контрагенты: " + Признак, Ложь);

КонецПроцедуры

// Переключение страницы разбора. Показываем ровно одну таблицу: у документов
// и контрагентов разные колонки, и обе сразу читались бы как один список.
&НаСервере
Процедура ПоказатьРазбор(Знач Заголовок, Знач ЭтоДокументы)

	Если ЭтоДокументы Тогда
		СписокКонтрагентов.Очистить();
		Количество = Документы.Количество();
	Иначе
		Документы.Очистить();
		Количество = СписокКонтрагентов.Количество();
	КонецЕсли;

	Элементы.ТаблицаДокументов.Видимость = ЭтоДокументы;
	Элементы.ТаблицаСписокКА.Видимость = НЕ ЭтоДокументы;

	ТекстРазбора = Заголовок + ", строк: " + Формат(Количество, "ЧГ=0");
	Элементы.НадписьРазбор.Заголовок = ТекстРазбора;
	Элементы.СтраницыЦентра.ТекущаяСтраница = Элементы.СтраницаРазбор;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Разбор идет по состоянию ЭДО, поэтому двойной щелчок открывает карточку «Состояние ЭДО»
	// с историей отправок (просьба оператора 13.09). Сам документ - кнопкой «Открыть».
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЭДО_Клиент.ОткрытьКарточкуСостоянияЭДО(ТекущиеДанные.Документ, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСписокКАВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаСписокКА.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьЗначение(ТекущиеДанные.Контрагент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлементВыполнить(Команда)

	Если Элементы.ТаблицаДокументов.Видимость И Элементы.ТаблицаДокументов.ТекущиеДанные <> Неопределено Тогда
		ОткрытьЗначение(Элементы.ТаблицаДокументов.ТекущиеДанные.Документ);
		Возврат;
	КонецЕсли;

	Если Элементы.ТаблицаСписокКА.Видимость И Элементы.ТаблицаСписокКА.ТекущиеДанные <> Неопределено Тогда
		ОткрытьЗначение(Элементы.ТаблицаСписокКА.ТекущиеДанные.Контрагент);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, "Выберите строку на закладке Разбор");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьAPIВыполнить(Команда)

	ПоказатьПредупреждение(, ПроверитьAPIНаСервере());

КонецПроцедуры

// Единственное место формы, которое ходит в сеть, и только по кнопке.
// Проверяется каждая учетная запись отдельно: у организаций свои токены и могут быть свои
// хосты, а ПроверитьКонтурAPI без организации при нескольких учетных записях отказывает.
&НаСервере
Функция ПроверитьAPIНаСервере()

	Записи = ЭДО_Сервер.УчетныеЗаписиЭДО();
	Если Записи.Количество() = 0 Тогда
		Возврат "В базе не задана учетная запись ЭДО ни для одной организации";
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Попытка
			Результат = ЭДО_Сервер.ПроверитьКонтурAPI(Запись.Организация);
			Текст = ?(ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Описание"),
				Результат.Описание, Строка(Результат));
		Исключение
			Текст = "проверка не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Строки.Добавить(Строка(Запись.Организация) + " - " + Текст);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура СнятьПаузуВыполнить(Команда)

	Если НЕ Элементы.ТаблицаСписокКА.Видимость ИЛИ Элементы.ТаблицаСписокКА.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите контрагента на закладке Разбор");
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ТаблицаСписокКА.ТекущиеДанные;
	Если НЕ ТекущиеДанные.НаПаузе Тогда
		ПоказатьПредупреждение(, "У этого контрагента отправка не приостановлена");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СнятьПаузуЗавершение", ЭтотОбъект, ТекущиеДанные.Контрагент);
	ПоказатьВопрос(Оповещение, "Возобновить отправку контрагенту " + ТекущиеДанные.Контрагент + "?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузуЗавершение(Ответ, Контрагент) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СнятьПаузуНаСервере(Контрагент);
	ОбновитьНаСервере();
	ПоказатьПредупреждение(, "Отправка возобновлена");

КонецПроцедуры

&НаСервере
Процедура СнятьПаузуНаСервере(Знач Контрагент)

	ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(Контрагент);

КонецПроцедуры

// Отправка из разбора - та же ручная отправка, что в карточке документа (ЭДО_Сервер.ОтправитьВручную),
// только пакетом. Вопросы те же, но задаются один раз на пакет: сколько из выделенных уже
// подписаны контрагентом и, после первого прохода, сколько уперлись в гейт, который человек
// вправе снять. Спрашивать про гейт до отправки нельзя: неизвестно, в какую причину упрется документ.
&НаКлиенте
Процедура ОтправитьВыделенныеВыполнить(Команда)

	Если НЕ Элементы.ТаблицаДокументов.Видимость
		ИЛИ Элементы.ТаблицаДокументов.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите документы на закладке Разбор");
		Возврат;
	КонецЕсли;

	Выделенные = Новый Массив;
	Подписанные = Новый Массив;
	Для Каждого Ид Из Элементы.ТаблицаДокументов.ВыделенныеСтроки Цикл
		СтрокаДокумента = Документы.НайтиПоИдентификатору(Ид);
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Выделенные.Добавить(Ид);
		// Подписанность - по тексту "Принят" в колонке ЭДО, как в витрине: ЭДО_КодСостояния в бою пуст.
		Если ВРег(СокрЛП(СтрокаДокумента.Состояние)) = ВРег("Принят") Тогда
			Подписанные.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;

	Если Выделенные.Количество() > МаксДокументовЗаРаз() Тогда
		ПоказатьПредупреждение(, "Выделено документов: " + Выделенные.Количество()
			+ ". За одно нажатие отправляется не больше " + МаксДокументовЗаРаз()
			+ " — иначе вызов сервера обрывается по таймауту на середине пакета.");
		Возврат;
	КонецЕсли;

	Текст = "Отправить в ЭДО документов: " + Выделенные.Количество() + "?"
		+ Символы.ПС + "Уже отправленные уйдут повторно, у контрагента появится новый экземпляр.";
	Кнопки = Новый СписокЗначений;
	Если Подписанные.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.ПС
			+ "Из них ПОДПИСАНЫ контрагентом: " + Подписанные.Количество()
			+ ". Переотправка создаст у него второй экземпляр на ту же отгрузку.";
		Если Подписанные.Количество() < Выделенные.Количество() Тогда
			Кнопки.Добавить("БезПодписанных", "Без подписанных ("
				+ (Выделенные.Количество() - Подписанные.Количество()) + ")");
		КонецЕсли;
		Кнопки.Добавить("Все", "Отправить все");
	Иначе
		Кнопки.Добавить("Все", "Отправить");
	КонецЕсли;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Отмена");

	Контекст = Новый Структура("Выделенные, Подписанные", Выделенные, Подписанные);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьВыделенныеЗавершение", ЭтотОбъект, Контекст),
		Текст, Кнопки, , КодВозвратаДиалога.Отмена);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыделенныеЗавершение(Ответ, Контекст) Экспорт

	Если Ответ <> "Все" И Ответ <> "БезПодписанных" Тогда
		Возврат;
	КонецЕсли;

	Отправки = Новый Массив;
	Для Каждого Ид Из Контекст.Выделенные Цикл
		Если Ответ = "БезПодписанных" И Контекст.Подписанные.Найти(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отправки.Добавить(Новый Структура("Ид, Гейт", Ид, ""));
	КонецЦикла;

	ВыполнитьОтправку(Отправки);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтправку(Знач Отправки)

	Состояние("Центр управления ЭДО", , "Отправляю документов: " + Отправки.Количество() + "…");
	Сводка = ОтправитьСтрокиНаСервере(Отправки);
	Состояние();

	Если Сводка.Преодолимые.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьПреодолевГейтЗавершение", ЭтотОбъект, Сводка),
			Сводка.Текст + Символы.ПС + Символы.ПС
			+ "Не ушли, но человек вправе отправить их сам: " + Сводка.Преодолимые.Количество()
			+ " (старше даты начала работы с оператором или уже уходили через СБИС)." + Символы.ПС
			+ "Если документ уже был принят контрагентом по прежнему каналу, у него появится"
			+ " второй экземпляр на ту же отгрузку." + Символы.ПС + Символы.ПС
			+ "Все равно отправить их?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, Сводка.Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПреодолевГейтЗавершение(Ответ, Сводка) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Второй проход только по упершимся в преодолимый гейт и только с их кодом причины:
	// снятие одного гейта не должно открывать документу другой.
	ВыполнитьОтправку(Сводка.Преодолимые);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МаксДокументовЗаРаз()

	Возврат 100;

КонецФункции

// Отправка строк разбора. Итог по каждому документу уходит в сообщения формы (там его видно
// списком и можно перейти к документу), колонка "Состояние" перечитывается из базы.
&НаСервере
Функция ОтправитьСтрокиНаСервере(Знач Отправки)

	Сводка = Новый Структура("Текст, Преодолимые", "", Новый Массив);
	Отправлено = 0;
	Удержано = 0;
	Ошибок = 0;

	СвСостояние = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
	Для Каждого Отправка Из Отправки Цикл
		СтрокаДокумента = Документы.НайтиПоИдентификатору(Отправка.Ид);
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Итог = ЭДО_Сервер.ОтправитьВручную(СтрокаДокумента.Документ, Отправка.Гейт);
		Если Итог.Успех Тогда
			Отправлено = Отправлено + 1;
		ИначеЕсли Итог.ГейтПреодолим И НЕ ЗначениеЗаполнено(Отправка.Гейт) Тогда
			Сводка.Преодолимые.Добавить(Новый Структура("Ид, Гейт", Отправка.Ид, Итог.КодПричины));
		ИначеЕсли Итог.Заголовок = "Ошибка отправки" Тогда
			Ошибок = Ошибок + 1;
		Иначе
			Удержано = Удержано + 1;
		КонецЕсли;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Строка(СтрокаДокумента.Документ) + ": " + Итог.Заголовок + ". " + Итог.Текст;
		Сообщение.Сообщить();

		Если СвСостояние <> Неопределено И НЕ СвСостояние.Пустая() Тогда
			Значение = ЭДО_Сервер.ЗначениеСвойстваОбъекта(СтрокаДокумента.Документ, СвСостояние);
			СтрокаДокумента.Состояние = ?(Значение = Неопределено, "", Строка(Значение));
		КонецЕсли;
	КонецЦикла;

	Сводка.Текст = "Отправлено: " + Отправлено
		+ ?(Удержано > 0, ", не пропущено механизмом: " + Удержано, "")
		+ ?(Ошибок > 0, ", ошибок: " + Ошибок, "")
		+ ?(Сводка.Преодолимые.Количество() > 0, ", ждут решения: " + Сводка.Преодолимые.Количество(), "")
		+ ". Итог по каждому документу — в сообщениях под формой.";

	Возврат Сводка;

КонецФункции

// Причина отказа нужна прямо в списке: без нее разбор отказов - это открытие карточек по одной.
// Спрашиваем оператора только по отказам и ошибкам отправки, пачками по 50 цепочек.
&НаСервере
Процедура ЗаполнитьПричиныОтказа()

	// Имя "Состояния" занято реквизитом формы (таблица "По состояниям"): присваивание ему
	// падало "Нельзя изменять поле, содержащее объект данных формы" при любом переходе в разбор.
	СостоянияСПричиной = Новый Соответствие;
	СостоянияСПричиной.Вставить(ВРег("Отказ контрагента"), Истина);
	СостоянияСПричиной.Вставить(ВРег("Ошибка: не отправлен"), Истина);

	Ссылки = Новый Массив;
	Для Каждого СтрокаДокумента Из Документы Цикл
		Если СостоянияСПричиной.Получить(ВРег(СокрЛП(СтрокаДокумента.Состояние))) <> Неопределено
			И Ссылки.Количество() < МаксПричинЗаРаз() Тогда
			Ссылки.Добавить(СтрокаДокумента.Документ);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Причины = ЭДО_Сервер.ПричиныОтказаДокументов(Ссылки);
	Исключение
		// Причина - подсказка, список без нее все равно полезен.
		Возврат;
	КонецПопытки;

	Для Каждого СтрокаДокумента Из Документы Цикл
		ТекстПричины = Причины.Получить(СтрокаДокумента.Документ);
		Если ТекстПричины <> Неопределено Тогда
			СтрокаДокумента.Причина = ?(ЗначениеЗаполнено(ТекстПричины), ТекстПричины, "(причина не указана)");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Потолок - чтобы щелчок по большой группе не превращался в минутное ожидание:
// 500 документов - это 10 запросов к оператору.
&НаСервереБезКонтекста
Функция МаксПричинЗаРаз()

	Возврат 500;

КонецФункции
