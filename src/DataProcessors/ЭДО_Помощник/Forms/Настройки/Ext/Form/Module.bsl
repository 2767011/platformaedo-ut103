// Настройки расширения "ЦентрУправленияЭДО": одно место, где видно и правится всё,
// от чего зависит работа отправки.
//
// Форма ничего не знает про состав настроек: и поля, и проверка готовности идут
// от реестра `ЭДО_Сервер.ОписаниеНастроекЭДО()`. Добавил параметр в реестр -
// он появляется в проверке сам; на форму остаётся добавить только поле.
//
// Все настройки пишутся в ОБЩЕЕ хранилище (пользователь ""), а не в персональное.
// До 22.08.2026 отпечаток подписанта лежал в настройках того, кто его задал: работало
// лишь потому, что настраивал и отправлял один служебный пользователь, а у бухгалтера
// из его сеанса подпись не находилась.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНастройкиНаСервере();
	Оповестить("ЭДО_НастройкиИзменены");
	ПоказатьПредупреждение(, "Настройки записаны.");
КонецПроцедуры

// «Проверить» перечитывает настройки из хранилища - и до этой правки молча затирала всё,
// что человек набрал, но ещё не записал (дату, отпечаток после «Выбрать сертификат»).
// Проверить можно только записанное, поэтому при незаписанных изменениях спрашиваем.
// Незаписанное определяется сравнением полей с хранилищем, а не флагом Модифицированность:
// у формы обработки без основного реквизита платформа этот флаг при вводе не ставит.
&НаКлиенте
Процедура ПроверитьГотовность(Команда)
	Если ЕстьНезаписанныеИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьГотовностьЗавершение", ЭтотОбъект),
			"Есть незаписанные изменения. Проверяется только то, что записано." + Символы.ПС
			+ "Записать настройки и проверить?", РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНастройкиНаСервере();
		Оповестить("ЭДО_НастройкиИзменены");
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		// проверяем записанное, введённое в полях не трогаем
		ЗаполнитьСостояниеГотовности();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойства(Команда)
	Вопрос = "Завести недостающие свойства объектов? Существующие не изменяются.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗавестиСвойстваЗавершение", ЭтотОбъект),
		Вопрос, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойстваЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ЗавестиСвойстваНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВОбщие(Команда)
	// Разовая операция для баз, настроенных до 22.08.2026: поднимает персональные
	// значения в общие, чтобы настройки видел не только тот, кто их задавал.
	ПоказатьПредупреждение(, ПеренестиВОбщиеНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСертификат(Команда)
	Список = СертификатыСервераСписком();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У учётки сервера 1С не установлено ни одного сертификата."
			+ " Ставить надо в хранилище ТОЙ учётки, под которой работает служба кластера.");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыбратьСертификатЗавершение", ЭтотОбъект),
		Список, , Список[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСертификатЗавершение(ЭлементСписка, ДополнительныеПараметры) Экспорт
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтпечатокПодписанта = ЭлементСписка.Значение;
	ОбновитьСведенияОСертификатеНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСертификат(Команда)
	// сетевая проверка: ходит к УЦ за списком отзыва
	ОбновитьСведенияОСертификатеНаСервере(Истина);
КонецПроцедуры

// Тот же список сертификатов сервера, что и общий «Выбрать сертификат», но результат
// пишется в текущую строку таблицы учетных записей организаций, а не в общий отпечаток.
&НаКлиенте
Процедура ВыбратьСертификатОрганизации(Команда)
	ТекущаяСтрока = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку организации.");
		Возврат;
	КонецЕсли;
	Список = СертификатыСервераСписком();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У учётки сервера 1С не установлено ни одного сертификата."
			+ " Ставить надо в хранилище ТОЙ учётки, под которой работает служба кластера.");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыбратьСертификатОрганизацииЗавершение", ЭтотОбъект),
		Список, , Список[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСертификатОрганизацииЗавершение(ЭлементСписка, ДополнительныеПараметры) Экспорт
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.Отпечаток = ЭлементСписка.Значение;
	ТекущаяСтрока.Сертификат = ЭлементСписка.Представление;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СертификатыСервераСписком()
	Список = Новый СписокЗначений;
	Для Каждого С Из ЭДО_Сервер.УстановленныеСертификатыПодписи() Цикл
		Список.Добавить(С.Отпечаток, С.Представление);
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаСервере
Процедура ОбновитьСведенияОСертификатеНаСервере(ПроверятьОтзыв)
	// Смотрим на то, что ВВЕДЕНО в форме, а не на записанную настройку: иначе после выбора
	// сертификата сведения показывали бы прежний, пока не нажмут "Записать".
	Состояние = ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(ОтпечатокПодписанта, ПроверятьОтзыв);
	СведенияОСертификате = СтроковыеСведенияОСертификате(Состояние);
	ЗаполнитьСостояниеГотовности();
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтроковыеСведенияОСертификате(Состояние)
	Если НЕ Состояние.Задан Тогда
		Возврат "Отпечаток не задан — нажмите «Выбрать сертификат».";
	КонецЕсли;
	Если НЕ Состояние.Найден Тогда
		Возврат "🔴 " + Состояние.Описание;
	КонецЕсли;

	Текст = Состояние.Субъект + Символы.ПС + Состояние.Описание;
	Если Состояние.Отозван ИЛИ Состояние.Просрочен Тогда
		Возврат "🔴 " + Текст;
	ИначеЕсли Состояние.ДнейОсталось <= 30 Тогда
		Возврат "⚠️ Сертификат кончается меньше чем через месяц — пора перевыпускать." + Символы.ПС + Текст;
	КонецЕсли;
	Возврат Текст;
КонецФункции

&НаСервере
Процедура ПрочитатьНастройкиВФорму()

	ДатаНачалаОтправки      = ЭДО_Сервер.НастройкаЭДО("ДатаНачалаОтправки");
	ГлубинаДнейОтправки     = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейОтправки");
	ЛимитДокументовЗаПрогон = ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон");
	ОтпечатокПодписанта     = ЭДО_Сервер.НастройкаЭДО("ОтпечатокПодписанта");
	Хост                    = ЭДО_Сервер.НастройкаЭДО("Хост");
	ПрочиеНашиАдресаЭДО     = ЭДО_Сервер.НастройкаЭДО("ПрочиеНашиАдресаЭДО");
	ГотовыеСтатусыЗаказа    = ЭДО_Сервер.НастройкаЭДО("ГотовыеСтатусыЗаказа");
	ГлубинаДнейСинхронизацииСтатусов = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
	ТаймаутHTTPСек          = ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек");

	// без сетевой проверки отзыва: открытие формы не должно ждать УЦ
	СведенияОСертификате = СтроковыеСведенияОСертификате(
		ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(ОтпечатокПодписанта, Ложь));

	// какое окно отбора получится из двух ограничений - показываем, чтобы не считать в уме
	Граница = ЭДО_Сервер.НижняяГраницаОтбора();
	ДействующееОкно = "с " + Формат(Граница, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(ДатаНачалаОтправки) И Граница = НачалоДня(ДатаНачалаОтправки),
			" (по дате начала)", " (по глубине в днях)");

	// учетные записи организаций у оператора - своя строка на каждую; пока список пуст,
	// работает общий ОтпечатокПодписанта выше (см. ЭДО_Сервер.УчетныеЗаписиИзОбщейНастройки)
	УчетныеЗаписи.Очистить();
	Для Каждого Запись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Строка = УчетныеЗаписи.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись);
		Строка.Сертификат = ПредставлениеСертификатаОрганизации(
			ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(Запись.Отпечаток, Ложь));
	КонецЦикла;

	ЗаполнитьСостояниеГотовности();
КонецПроцедуры

// Короткое представление сертификата для колонки таблицы учетных записей: без эмодзи и
// многострочных пояснений, как в СтроковыеСведенияОСертификате, - там текст под readonly-поле
// сертификата сервера, здесь - под узкую колонку таблицы организаций.
&НаСервереБезКонтекста
Функция ПредставлениеСертификатаОрганизации(Состояние)
	Если НЕ Состояние.Задан Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ Состояние.Найден Тогда
		Возврат "не установлен у учётки сервера";
	КонецЕсли;
	Возврат Состояние.Субъект + " — до " + Формат(Состояние.ДействителенПо, "ДФ=dd.MM.yyyy");
КонецФункции

// Отличается ли хоть одно поле формы от записанного в хранилище.
&НаСервере
Функция ЕстьНезаписанныеИзменения()
	Возврат ДатаНачалаОтправки <> ЭДО_Сервер.НастройкаЭДО("ДатаНачалаОтправки")
		ИЛИ ГлубинаДнейОтправки <> ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейОтправки")
		ИЛИ ЛимитДокументовЗаПрогон <> ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон")
		ИЛИ СокрЛП(ОтпечатокПодписанта) <> ЭДО_Сервер.НастройкаЭДО("ОтпечатокПодписанта")
		ИЛИ СокрЛП(Хост) <> ЭДО_Сервер.НастройкаЭДО("Хост")
		ИЛИ СокрЛП(ПрочиеНашиАдресаЭДО) <> ЭДО_Сервер.НастройкаЭДО("ПрочиеНашиАдресаЭДО")
		ИЛИ СокрЛП(ГотовыеСтатусыЗаказа) <> ЭДО_Сервер.НастройкаЭДО("ГотовыеСтатусыЗаказа")
		ИЛИ ГлубинаДнейСинхронизацииСтатусов <> ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов")
		ИЛИ ТаймаутHTTPСек <> ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек")
		ИЛИ УчетныеЗаписиИзменились();
КонецФункции

// Сравнение построчно с ЭДО_Сервер.УчетныеЗаписиЭДО(): другое число строк или другое хоть
// одно поле хотя бы в одной строке - считаем незаписанным изменением.
&НаСервере
Функция УчетныеЗаписиИзменились()
	Записанные = ЭДО_Сервер.УчетныеЗаписиЭДО();
	Если УчетныеЗаписи.Количество() <> Записанные.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Индекс = 0 По УчетныеЗаписи.Количество() - 1 Цикл
		Строка = УчетныеЗаписи[Индекс];
		Запись = Записанные[Индекс];
		// Отпечаток и ИдентификаторУчастника сравниваем через СокрЛП: их так же обрезает
		// ЭДО_Сервер.ЗаписатьУчетныеЗаписиЭДО при сохранении. Остальные поля ядро не обрезает.
		Если Строка.Организация <> Запись.Организация
			ИЛИ СокрЛП(Строка.Отпечаток) <> Запись.Отпечаток
			ИЛИ Строка.ТипПодписанта <> Запись.ТипПодписанта
			ИЛИ Строка.ДолжностьПодписанта <> Запись.ДолжностьПодписанта
			ИЛИ Строка.НомерМЧД <> Запись.НомерМЧД
			ИЛИ Строка.ДатаМЧД <> Запись.ДатаМЧД
			ИЛИ СокрЛП(Строка.ИдентификаторУчастника) <> Запись.ИдентификаторУчастника Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьСостояниеГотовности()
	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() = 0 Тогда
		СостояниеГотовности = "Всё настроено — отправка работать может.";
	Иначе
		СостояниеГотовности = "Отправка НЕ РАБОТАЕТ, пока не устранено:" + Символы.ПС
			+ "• " + СтрСоединить(Недостающее, Символы.ПС + "• ");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()
	ЭДО_Сервер.УстановитьНастройкуЭДО("ДатаНачалаОтправки", ДатаНачалаОтправки);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейОтправки", ГлубинаДнейОтправки);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ЛимитДокументовЗаПрогон", ЛимитДокументовЗаПрогон);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ОтпечатокПодписанта", СокрЛП(ОтпечатокПодписанта));
	ЭДО_Сервер.УстановитьНастройкуЭДО("Хост", СокрЛП(Хост));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ПрочиеНашиАдресаЭДО", СокрЛП(ПрочиеНашиАдресаЭДО));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГотовыеСтатусыЗаказа", СокрЛП(ГотовыеСтатусыЗаказа));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейСинхронизацииСтатусов", ГлубинаДнейСинхронизацииСтатусов);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ТаймаутHTTPСек", ТаймаутHTTPСек);

	Записи = Новый Массив;
	Для Каждого Строка Из УчетныеЗаписи Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Организация) Тогда
			Продолжить;
		КонецЕсли;
		Запись = ЭДО_Сервер.НоваяУчетнаяЗаписьЭДО();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		Записи.Добавить(Запись);
	КонецЦикла;
	ЭДО_Сервер.ЗаписатьУчетныеЗаписиЭДО(Записи);

	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаСервере
Функция ЗавестиСвойстваНаСервере()
	Итог = ЭДО_Сервер.ОбеспечитьСвойстваОбъектов();
	ЗаполнитьСостояниеГотовности();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

&НаСервере
Функция ПеренестиВОбщиеНаСервере()
	Итог = ЭДО_Сервер.ПеренестиНастройкиВОбщие();
	ПрочитатьНастройкиВФорму();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

#КонецОбласти
